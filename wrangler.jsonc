{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pau-nafeesah-beauty-room",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat is required by the Next.js adapter. global_fetch_strictly_public lets
  // the Worker call Twilio over the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pau-nafeesah-beauty-room"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pau-nafeesah",
      // Replace with the id printed by `npx wrangler d1 create pau-nafeesah`.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "pau-nafeesah-photos"
    }
  ]
}
